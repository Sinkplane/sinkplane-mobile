{
  "name": "sinkplane-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint src __tests__ jest",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest -c jest.config.unit.js",
    "test:unit:watch": "jest -c jest.config.unit.js --watch",
    "test:unit:coverage": "jest -c jest.config.unit.js --coverage",
    "test:e2e": "jest -c jest.config.e2e.js",
    "test:e2e:coverage": "jest -c jest.config.e2e.js --coverage",
    "test:coverage": "npm run test:unit:coverage && npm run test:e2e:coverage",
    "test:ci": "jest -c jest.config.unit.js --ci --coverage && jest -c jest.config.e2e.js --ci --coverage",
    "prepare": "husky",
    "link:shared": "./scripts/link-shared-dist.sh",
    "unlink:shared": "./scripts/link-shared-dist.sh --unlink"
  },
  "dependencies": {
    "@sinkplane/shared": "^0.1.2",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.21",
    "expo-font": "~58.0.10",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "^58.0.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "expo lint --fix"
    ]
  },
  "private": true
}
