# Registry and auth only. pnpm settings (peer handling, patches, build scripts) live in
# pnpm-workspace.yaml.

# @sinkplane/* packages are published to GitHub Packages
# (sinkplane-shared publishes there on v* tags — see its publish workflow).
@sinkplane:registry=https://npm.pkg.github.com

# Auth: locally the token lives in ~/.npmrc
# (//npm.pkg.github.com/:_authToken=ghp_…). On EAS Build, add
#   //npm.pkg.github.com/:_authToken=${NPM_TOKEN}
# below — EAS replaces ${NPM_TOKEN} from the project's NPM_TOKEN environment
# variable automatically. CI writes ~/.npmrc directly (see .github/workflows).
# Never commit a real token here.
